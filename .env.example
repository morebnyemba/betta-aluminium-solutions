# Public base URL for canonical links, Open Graph tags, sitemap.xml and robots.txt.
# Until this is set, those all fall back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Where /api/quote forwards enquiries. Any endpoint accepting a JSON POST works
# (Formspree, n8n, a Zapier catch hook, your own service). Leave it unset and
# the API returns 503 "not_configured"; the form then shows a prefilled mailto
# fallback instead of silently dropping the enquiry.
# QUOTE_WEBHOOK_URL=
